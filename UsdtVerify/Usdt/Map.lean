import UsdtVerify.Evm.Calldata
import UsdtVerify.Evm.GasRules
import UsdtVerify.Evm.Local.Rules
import UsdtVerify.Usdt.Steps

/-!
# The dispatcher of USDT and the storage layout it reads

The storage of TetherToken (Solidity 0.4.17), as the bytecode reads it:

- slot 0: `owner` in the low 160 bits, `paused` in byte 20 (`byte20`);
- slot 1: `_totalSupply`;
- slot 2: the base of the mapping `balances` (`mapSlot a 2`);
- slot 3: `basisPointsRate`; slot 4: `maximumFee`;
- slot 5: the base of the nested mapping `allowed` (`allowed[o][s]` at `mapSlot s (mapSlot o 5)`);
- slot 6: the base of the mapping `isBlackListed`;
- slot 7: `name`; slot 8: `symbol`; slot 9: `decimals`;
- slot 10: `upgradedAddress` in the low 160 bits, `deprecated` in byte 20.

`mapSlot`, `byte20` and `storageAt` are generic (Evm/Storage.lean).

The parts below keep their own headers:

- The dispatcher of USDT
- The selector table of USDT
-/

section

/-!
## The dispatcher of USDT

- At 0, `60 60 60 40 52` writes the word 0x60 at offset 0x40 of memory (the free memory pointer).
- At 5, `60 04 36 10 61 01 96 57` jumps to 0x196 when the call data has fewer than 4 bytes.
- At 13, the code divides the call data word at 0 by `2 ^ 224` and masks it to 32 bits.
- At 54, a table of 32 entries compares that selector with each key and jumps to its function.
-/

namespace UsdtVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic
open GasCosts

variable {fork : Fork} {message : Message fork} {state : State.TransactionState}
  {substate : Substate}

/-- The memory after the first write: 96 bytes, with the word 0x60 at offset 0x40. -/
def MEM0 : ByteArray := memoryWrite (memoryExtend .empty 96) 64 (wordBytes 0x60)

/-- The code before the table: from a call of 4 bytes or more, it computes the selector. -/
theorem prelude (hsize : 4 ≤ message.data.size) (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} (hg : 62 ≤ gas) :
    Gas.HoareG fork (At CODE message 0 [] .empty gas state substate)
      (At CODE message 54 [BitVec.ofNat 256 (selector message.data)] MEM0 (gas - 62) state
        substate) := by
  have hext : extendMemory ByteArray.empty.size [((BitVec.ofNat 256 (0x40 : UInt8).toNat : U256),
      (32 : U256))] = ⟨9, 96⟩ := by decide
  step push1R 0x60
  step push1R 0x40
  step Gas.mstoreG (by code_fact) (by code_fact) (by simp only [hext]; omega)
  step Gas.reshapeG rfl (by rw [hext]) (show _ = gas - 18 by simp only [hext]; omega)
  step push1R 0x04
  step Gas.calldatasizeG (by code_fact) (by code_fact) (by gas_ok) (by stk_ok)
  step binR 0x10 Local.instruction_lt
  step pushR 2 0x0196
  refine Triple.seq (Gas.jumpi_of_eq_zeroG (by code_fact) (by code_fact) (by gas_ok) ?_) ?_
  · have h4 : (BitVec.ofNat 256 (UInt8.toNat 4) : U256).toNat = 4 := by decide
    simp only [lessThan, h4, BitVec.toNat_ofNat, Nat.mod_eq_of_lt hsize']
    split <;> first | omega | rfl
  step push1R 0x00
  step Gas.calldataloadG (by code_fact) (by code_fact) (by gas_ok)
  step pushR 29 (BitVec.ofNat 256 (2 ^ 224))
  step swapR 0
  step binR 0x04 Local.instruction_div
  step pushR 4 (BitVec.ofNat 256 0xffffffff)
  step binR 0x16 Local.instruction_and
  refine Gas.reshapeG ?_ (by rfl) (by gas_ok)
  have h0 : (BitVec.ofNat 256 (UInt8.toNat 0) : U256).toNat = 0 := by decide
  simp only [h0, List.cons.injEq, and_true]
  exact selector_word message.data

end UsdtVerify

end

section

/-!
## The selector table of USDT

The table starts at 54 and has 32 entries of 11 bytes: DUP1, PUSH4 key, EQ, PUSH2 destination, JUMPI.

`ENTRIES` lists them as they are in the bytecode (generated by `scripts/map.py`; see docs/MAP.md).

After the table, at 406, the code handles a selector that no entry has.
-/

namespace UsdtVerify

open EthLib.Base (Fork U256)
open EthLib.Execution
open EthLib.Execution.Evm
open EthLib.Execution.Evm.Logic

/-- The entries of the selector table, each a key and its destination. -/
def ENTRIES : List (U256 × U256) := [
  (0x06fdde03, 411),
  (0x0753c30c, 553),
  (0x095ea7b3, 610),
  (0x0e136b19, 676),
  (0x0ecb93c0, 721),
  (0x18160ddd, 778),
  (0x23b872dd, 819),
  (0x26976e3f, 916),
  (0x27e235e3, 1001),
  (0x313ce567, 1078),
  (0x35390714, 1119),
  (0x3eaaf86b, 1160),
  (0x3f4ba83a, 1201),
  (0x59bf1abe, 1222),
  (0x5c658165, 1303),
  (0x5c975abb, 1411),
  (0x70a08231, 1456),
  (0x8456cb59, 1533),
  (0x893d20e8, 1554),
  (0x8da5cb5b, 1639),
  (0x95d89b41, 1724),
  (0xa9059cbb, 1866),
  (0xc0324c77, 1932),
  (0xcc872b66, 1976),
  (0xdb006a75, 2011),
  (0xdd62ed3e, 2046),
  (0xdd644f72, 2154),
  (0xe47d6060, 2195),
  (0xe4997dc5, 2276),
  (0xe5b5019a, 2333),
  (0xf2fde38b, 2374),
  (0xf3bdc228, 2431)]

/-- An entry of a table in front of the rest, with the rest as the first goal. -/
theorem Table.cons' {code : ByteArray} {n m : Fin 33} {pc : Nat} {key dest : U256}
    {entries : List (U256 × U256)} (rest : Table code n m (pc + entrySize n m) entries)
    (b0 : ByteAt code pc 0x80) (b1 : ByteAt code (pc + 1) (0x5f + UInt8.ofNat n.val))
    (hkey : pushData code (pc + 1) n = key) (b2 : ByteAt code (pc + 1 + (1 + n)) 0x14)
    (b3 : ByteAt code (pc + 1 + (1 + n) + 1) (0x5f + UInt8.ofNat m.val))
    (hdest : pushData code (pc + 1 + (1 + n) + 1) m = dest)
    (b4 : ByteAt code (pc + 1 + (1 + n) + 1 + (1 + m)) 0x57)
    (valid : isValidJumpDest (validJumpDestinations code) dest.toNat = true) :
    Table code n m pc ((key, dest) :: entries) :=
  ⟨b0, b1, hkey, b2, b3, hdest, b4, valid, rest⟩

/-- The code holds the selector table at 54, with keys of 4 bytes and destinations of 2. -/
theorem table : Table CODE 4 2 54 ENTRIES := by
  unfold ENTRIES
  repeat refine Table.cons' ?_ ⟨?_, ?_⟩ ⟨?_, ?_⟩ ?_ ⟨?_, ?_⟩ ⟨?_, ?_⟩ ?_ ⟨?_, ?_⟩ ?_
  all_goals first | exact True.intro | code_fact | valid_dest

variable {fork : Fork} {message : Message fork} {state : State.TransactionState}
  {substate : Substate}

/-- The dispatcher runs the prelude and the table. -/
theorem dispatch (hsize : 4 ≤ message.data.size) (hsize' : message.data.size < 2 ^ 256)
    {gas : Nat} (hg : 62 + 22 * tested (BitVec.ofNat 256 (selector message.data)) ENTRIES ≤ gas) :
    Gas.HoareG fork (At CODE message 0 [] .empty gas state substate)
      (At CODE message (branch (BitVec.ofNat 256 (selector message.data)) 54 (entrySize 4 2) ENTRIES)
        [BitVec.ofNat 256 (selector message.data)] MEM0
        (gas - 62 - 22 * tested (BitVec.ofNat 256 (selector message.data)) ENTRIES) state
        substate) :=
  (prelude hsize hsize' (by omega)).seq
    (Gas.branchTableG (by decide) (by decide) (by simp [STACK_LIMIT]) table (by omega))

end UsdtVerify

end
